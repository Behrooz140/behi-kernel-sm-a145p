# Halium / Ubuntu Touch config fragment for the a14m port (TEST BRANCH)
#
# Applied after mt6768_overlay.config, o22.config and a145p_advanced.config.
# Every option below is already enabled in the final v1.6.1 build (verified
# against configs/stock-a145pxxuedzj2.config and the live /proc/config.gz of
# SM-A145P). They are restated here so that the CI config sanity check fails
# loudly if a future rebase drops one of them.
#
# KMI RULE: do not enable NF_TABLES*, KSM, VXLAN, IPVLAN, CGROUP_PIDS,
# CFS_BANDWIDTH or any other option listed in a145p_advanced.config. The stock
# /vendor modules are built against the 6.6.118 vermagic and the exported-symbol
# CRC baseline in configs/kmi-baseline-v1.6.1.txt; changing an exported struct
# layout makes every one of them fail to load.

# Android HAL / binder (already y in the stock A145P config)
CONFIG_ASHMEM=y
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"

# Namespaces used by the Halium LXC container (the behi workflow already adds
# SYSVIPC/POSIX_MQUEUE/IPC_NS/PID_NS/USER_NS to gki_defconfig; keep them here too)
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_USER_NS=y
CONFIG_NET_NS=y
CONFIG_UTS_NS=y

# Container filesystem plumbing
CONFIG_DEVTMPFS=y
CONFIG_OVERLAY_FS=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y

# Module ABI: must stay exactly as in the released v1.6.1 kernel
CONFIG_MODULES=y
CONFIG_MODVERSIONS=y
